[
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "Find character"
    },
    "description": "Look a character up by exact name, optionally on one server, and return its profile, stats and equipment. With no exact match, or several, returns candidates instead",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "description": "the labels' language, empty is the region's own. Global takes en, de, es, fr, ja and pt-BR",
          "enum": [
            "ko",
            "zh-TW",
            "en",
            "de",
            "es",
            "fr",
            "ja",
            "pt-BR"
          ],
          "type": "string"
        },
        "name": {
          "description": "the character's exact name, case does not matter",
          "type": "string"
        },
        "region": {
          "description": "the region, empty is the server's default",
          "enum": [
            "kr",
            "tw",
            "nae",
            "naw",
            "eu",
            "sa",
            "asia"
          ],
          "type": "string"
        },
        "server": {
          "description": "the server's name, short name or id, as list_servers gives them (empty searches every server)",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "find_character"
  },
